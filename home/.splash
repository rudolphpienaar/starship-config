if [[ "${STARSHIP_SPLASH:-on}" == "off" || ! -o interactive ]]; then
  return
fi

if [[ -n "$TMUX" || "$TERM" == "dumb" ]]; then
  return
fi

_starship_splash_main() {
local box_h box_v box_tl box_tr box_bl box_br bullet content_width
local host_name arch kernel_line uptime_line
local pid user comm cpu mem
local weather_dir="" weather_index weather_spec weather_pid query label
local weather_blob condition forecast temp wind
local cal_file="" clock_file=""
local -a weather_specs weather_pids
local -i splash_subshell=$ZSH_SUBSHELL

setopt LOCAL_OPTIONS NO_MONITOR

TRAPEXIT() {
  (( ZSH_SUBSHELL == splash_subshell )) || return 0
  if [[ -n "$weather_dir" && -d "$weather_dir" ]]; then
    rm -r -- "$weather_dir"
  fi
  [[ -n "$cal_file" ]] && rm -f -- "$cal_file"
  [[ -n "$clock_file" ]] && rm -f -- "$clock_file"
}

if [[ "$LANG$LC_ALL$LC_CTYPE" == *UTF-8* ]]; then
  box_h="─"
  box_v="│"
  box_tl="┌"
  box_tr="┐"
  box_bl="└"
  box_br="┘"
  bullet="◆"
else
  box_h="-"
  box_v="|"
  box_tl="+"
  box_tr="+"
  box_bl="+"
  box_br="+"
  bullet="*"
fi

content_width=75

_starship_splash_rule() {
  local color="$1"
  local title="$2"
  local bar
  local border_width=$((content_width + 2))

  if [[ -n "$title" ]]; then
    local label=" $title "
    local remaining=$((border_width - ${#label}))
    if (( remaining < 0 )); then
      label=" ${title[1,border_width-2]} "
      remaining=0
    fi
    printf -v bar "%${remaining}s" ""
    bar="${bar// /$box_h}"
    print -P "%F{$color}$box_tl$label$bar$box_tr%f"
  else
    printf -v bar "%${border_width}s" ""
    bar="${bar// /$box_h}"
    print -P "%F{$color}$box_tl$bar$box_tr%f"
  fi
}

_starship_splash_footer() {
  local color="$1"
  local bar
  printf -v bar "%77s" ""
  bar="${bar// /$box_h}"
  print -P "%F{$color}$box_bl$bar$box_br%f"
}

_starship_splash_box_line() {
  local color="$1"
  shift
  local text="$*"
  local padded
  text="${text//$'\t'/    }"
  text="${text//$'\r'/}"
  if (( ${#text} > content_width )); then
    text="${text[1,content_width]}"
  fi
  printf -v padded "%-${content_width}s" "$text"
  print -P "%F{$color}$box_v%f $padded %F{$color}$box_v%f"
}

_starship_splash_box_stream() {
  local color="$1"
  while IFS= read -r line || [[ -n "$line" ]]; do
    _starship_splash_box_line "$color" "$line"
  done
}

host_name="$(hostname)"
arch="$(uname)"
kernel_line="$(uname -r)"
uptime_line="$(uptime 2>/dev/null)"

_starship_splash_rule 33 "console matrix"
_starship_splash_box_line 33 "$bullet host: $host_name   $bullet user: $USER"
_starship_splash_box_line 33 "$bullet term: $TERM   $bullet kernel: $kernel_line   $bullet arch: $arch"
_starship_splash_box_line 33 "$uptime_line"
_starship_splash_footer 33

print ""
_starship_splash_rule 81 "process board"
_starship_splash_box_line 81 "PID    USER       COMMAND                    CPU    MEM"
while IFS='|' read -r pid user comm cpu mem; do
  _starship_splash_box_line 81 "$(printf '%-6s %-10s %-24s %6s  %6s' "$pid" "$user" "$comm" "$cpu" "$mem")"
done < <(
  ps -Ao pid=,user=,comm=,%cpu=,%mem= 2>/dev/null | \
  awk '{
    pid=$1
    user=$2
    cpu=$(NF-1)
    mem=$NF
    $1=""; $2=""; $(NF-1)=""; $NF=""
    sub(/^[[:space:]]+/, "", $0)
    sub(/[[:space:]]+$/, "", $0)
    printf "%s|%s|%s|%s|%s\n", pid, user, $0, cpu, mem
  }' | sort -t '|' -k4,4nr | head -n 10
)
_starship_splash_footer 81

print ""
_starship_splash_rule 39 "session index"
{
  if command -v finger >/dev/null 2>&1; then
    finger -s 2>/dev/null || true
  elif command -v who >/dev/null 2>&1; then
    who 2>/dev/null || true
  else
    print "session listing unavailable"
  fi
} | _starship_splash_box_stream 39
_starship_splash_footer 39

print ""
_starship_splash_rule 214 "temperature cities"
if [[ "${STARSHIP_SPLASH_WEATHER:-on}" == "off" ]]; then
  _starship_splash_box_line 214 "weather disabled"
elif command -v curl >/dev/null 2>&1; then
  weather_dir="$(mktemp -d)"
  weather_specs=(
    'Boston|Boston'
    'New York City|New%20York%20City'
    'Troy, NY|Troy%20NY'
    'Cape Town|Cape%20Town'
  )
  weather_pids=()
  weather_index=1
  for weather_spec in "${weather_specs[@]}"; do
    query="${weather_spec#*|}"
    curl -fsS --connect-timeout 1 --max-time 2 \
      "https://wttr.in/$query?m&0&T" \
      >"$weather_dir/$weather_index" 2>/dev/null &
    weather_pids+=("$!")
    (( weather_index++ ))
  done
  for weather_pid in "${weather_pids[@]}"; do
    wait "$weather_pid" 2>/dev/null || true
  done

  weather_index=1
  for weather_spec in "${weather_specs[@]}"; do
    label="${weather_spec%%|*}"
    weather_blob="$(<"$weather_dir/$weather_index")"
    condition="unknown"
    forecast="feed unavailable"
    if [[ -n "$weather_blob" ]]; then
      condition="$(
        printf '%s\n' "$weather_blob" |
          sed -n '3p' |
          sed -E 's/^.*[[:space:]]{2,}([[:alpha:]].*)$/\1/; s/^[[:space:]]*//; s/[[:space:]]*$//'
      )"
      temp="$(
        printf '%s\n' "$weather_blob" |
          sed -n '4p' |
          grep -oE '[+-]?[0-9]+(\([+-]?[0-9]+\))? ?°C' |
          head -n 1
      )"
      wind="$(
        printf '%s\n' "$weather_blob" |
          sed -n '5p' |
          grep -oE '([←→↑↓↖↗↘↙][[:space:]]*)?[0-9]+ km/h' |
          head -n 1
      )"
      temp="$(
        printf '%s\n' "$temp" |
          sed -E \
            -e 's/^\+?([0-9]+)\(\+?([0-9]+)\)[[:space:]]*°C$/\1°C (feels like \2°C)/' \
            -e 's/^\+?([0-9]+)[[:space:]]*°C$/\1°C/'
      )"
      forecast="$(printf '%s %s' "$temp" "$wind" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]][[:space:]]*/ /g')"
    fi
    condition="${condition#"${condition%%[![:space:]]*}"}"
    condition="${condition%"${condition##*[![:space:]]}"}"
    forecast="${forecast#"${forecast%%[![:space:]]*}"}"
    forecast="${forecast%"${forecast##*[![:space:]]}"}"
    _starship_splash_box_line 214 "$(printf '%-16s  %-18s  %s' "$label" "$condition" "$forecast")"
    (( weather_index++ ))
  done
  rm -r -- "$weather_dir"
  weather_dir=""
else
  _starship_splash_box_line 214 "weather feed unavailable"
fi
_starship_splash_footer 214

cal_file="$(mktemp)"
clock_file="$(mktemp)"

if command -v cal >/dev/null 2>&1; then
  cal >"$cal_file" 2>/dev/null || : >"$cal_file"
else
  print "calendar unavailable" >"$cal_file"
fi

if command -v toilet >/dev/null 2>&1; then
  date '+%H:%M' | toilet -f future -F border >"$clock_file" 2>/dev/null || : >"$clock_file"
elif command -v figlet >/dev/null 2>&1; then
  date '+%H:%M' | figlet >"$clock_file" 2>/dev/null || : >"$clock_file"
else
  date '+%H:%M' >"$clock_file"
fi

print ""
_starship_splash_rule 178 "calendar and time"
paste "$cal_file" "$clock_file" | _starship_splash_box_stream 178
_starship_splash_footer 178
rm -f -- "$cal_file" "$clock_file"
cal_file=""
clock_file=""

if [[ "${STARSHIP_SPLASH_FETCH:-on}" != "off" ]] && command -v cpufetch >/dev/null 2>&1; then
  cpufetch
fi

if [[ "${STARSHIP_SPLASH_FETCH:-on}" != "off" ]] && command -v neofetch >/dev/null 2>&1; then
  print ""
  neofetch --disable WM --disable Resolution 2>/dev/null
  print ""
elif [[ "${STARSHIP_SPLASH_FETCH:-on}" != "off" ]] && command -v screenfetch >/dev/null 2>&1; then
  print ""
  screenfetch 2>/dev/null
  print ""
fi

print ""
_starship_splash_rule 135 "signal"
if [[ "${STARSHIP_SPLASH_FORTUNE:-on}" != "off" ]] && command -v fortune >/dev/null 2>&1; then
  fortune 2>/dev/null | _starship_splash_box_stream 135
else
  _starship_splash_box_line 135 "fortune unavailable"
fi
_starship_splash_footer 135
print ""
}

_starship_splash_main
unfunction _starship_splash_main _starship_splash_rule \
  _starship_splash_footer _starship_splash_box_line \
  _starship_splash_box_stream
